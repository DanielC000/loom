{
  "$schema": "https://turbo.build/schema.json",
  // Key EVERY task's cache on install-state: a change to the root lockfile (a dep add/bump) invalidates
  // all build caches, so a stale FULL TURBO replay can never serve a build that predates the dependency
  // change. turbo already tracks the lockfile implicitly; declaring it makes the dep→rebuild contract
  // explicit and version-independent. (The daemon-deploy build additionally `--force`s — see
  // packages/daemon/src/orchestration/restart.ts › deployBuildSteps — so its cache is fully defeated.)
  "globalDependencies": ["pnpm-lock.yaml"],
  "tasks": {
    // A CACHE HIT restores a task's cached `outputs` files without ever re-running its script — so it
    // never triggers Vite's own `emptyOutDir` clean, which only fires when `vite build` actually
    // executes. If `dist/` already holds a DIFFERENT prior build's content-hashed bundle (e.g. from an
    // earlier real build in this same worktree), a later cache-hit restore layers the restored files on
    // top instead of replacing them, leaving the stale bundle behind — reproduced live: a real build,
    // then a cache-hit restore of a different cached state, left both hashes in `dist/assets`
    // simultaneously. `clean` is declared `cache: false` (always actually runs, never itself a skip) and
    // sits ahead of `build` in the task graph, so `dist/` is wiped before EITHER a real build or a cache
    // restore writes into it — the only place this can be fixed, since a restore skips the build script
    // entirely. Only `@loom/web` defines a `clean` script (its dist is what a served bundle scan checks);
    // packages without one are a no-op here.
    "clean": {
      "cache": false
    },
    "build": {
      "dependsOn": ["^build", "clean"],
      // "!dist/build-info.json" (card 24f53a72): build-info.json is written by the SEPARATE, uncached
      // "stamp" task below, never by "build" itself — but a bare "dist/**" glob doesn't know that; it
      // captures WHATEVER happens to be sitting in dist/ when "build" finishes, which is ALWAYS before
      // "stamp" (stamp dependsOn build) — so it was silently sweeping build-info.json's PRE-stamp value
      // into "build"'s own cache snapshot too. Any LATER cache HIT for "build" (same content hash, e.g. a
      // non-forced rebuild whose invocation happens not to also request "stamp") then restores that frozen
      // snapshot, clobbering whatever "stamp" most recently wrote — reproduced live: a correctly-stamped
      // real HEAD sha was silently reverted to an unrelated earlier sha by nothing more than a same-hash
      // cache-hit `turbo build` with no source change at all. Excluding the file here means a "build"
      // cache hit/restore can never touch it, regardless of whether the invoking command also asked for
      // "stamp" — the ONLY writer left is "stamp" itself, which is unconditional (cache:false).
      "outputs": ["dist/**", "!dist/build-info.json"]
    },
    "@loom/daemon#build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**", "!dist/build-info.json"],
      // @loom/daemon's build script runs scripts/sync-claude-skills.mjs (outside this package's own file
      // tree), so it needs its own inputs entry keying the cache on that script too — otherwise a
      // script-only change is invisible to turbo and a bare `pnpm build` can replay a stale cache hit
      // without re-running it. $TURBO_DEFAULT$ preserves the normal git-tracked-files inputs.
      // scripts/write-build-info.mjs is DELIBERATELY not listed here any more — see the "stamp" task below.
      "inputs": ["$TURBO_DEFAULT$", "$TURBO_ROOT$/scripts/sync-claude-skills.mjs"]
    },
    "@loom/web#build": {
      "dependsOn": ["^build", "clean"],
      "outputs": ["dist/**", "!dist/build-info.json"]
    },
    // Card 3d7dccb9 — writes <package>/dist/build-info.json (scripts/write-build-info.mjs), split OUT of
    // the cached "build" task on purpose. `cache:false` means this task's script runs on EVERY invocation,
    // cache hit or miss for its "build" dependency — a turbo cache HIT for "build" proves (by turbo's own
    // cache-correctness guarantee) that the restored dist/** content is equivalent to actually compiling
    // THIS checkout's current tree, so re-stamping the CURRENT checkout's real `git rev-parse HEAD` here is
    // always correct — unlike the old design, where write-build-info.mjs ran INSIDE the cached "build"
    // script and so was cacheable+replayable itself: turbo shares its local cache directory across every
    // git worktree of the same repo (a deliberate turbo 2.x feature — confirmed via
    // `TURBO_LOG=debug turbo build`: "Using shared worktree cache at: <main checkout>/.turbo/cache",
    // `is_shared_worktree=true`), so a worker's own `pnpm build` (e.g. during its merge-gate self-check)
    // could populate a cache entry whose content matched a LATER build on a completely different checkout
    // — replaying that worker worktree's OWN `dist/build-info.json`, stamped with a sha that may not even
    // be reachable from mainline, into the canonical dist. See deploy-staleness.ts's module doc for the
    // full incident. Only @loom/daemon and @loom/web define a "stamp" script; a package with none (e.g.
    // @loom/shared, which ships no served artifact) is silently skipped by turbo, same as "lint" above.
    // Card 24f53a72 — "build"'s own OUTPUTS glob now excludes build-info.json (see "!dist/build-info.json"
    // above), so a "build" cache hit/restore can no longer clobber it either, even on an invocation that
    // omits "stamp" entirely — "stamp" is the sole writer of this file, full stop.
    "stamp": {
      "cache": false,
      "dependsOn": ["build"]
    },
    "typecheck": {
      "dependsOn": ["^build"]
    },
    "lint": {},
    "dev": {
      "cache": false,
      "persistent": true
    }
  }
}
